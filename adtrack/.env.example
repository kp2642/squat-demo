# Supabase 프로젝트 설정 → API 에서 복사
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 추적 코드 수집 API 가 DB 함수를 부를 때 사용 (서버에서만 쓰임, 절대 공개 금지)
SUPABASE_SERVICE_ROLE_KEY=
# 문의 이름·연락처 암호화 키: openssl rand -base64 32
# 잃어버리면 저장된 이름·연락처를 읽을 수 없으니 따로 안전하게 보관
LEAD_ENCRYPTION_KEY=
# (선택) 로컬 개발·테스트에서 Supabase 대신 PostgreSQL 에 직접 붙을 때
# DATABASE_URL=postgres://postgres@localhost:5432/postgres
